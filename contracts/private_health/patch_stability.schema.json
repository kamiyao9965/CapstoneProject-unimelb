{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_count", "drift_count", "union_count", "stability",
        "stable_items", "drifting_items"
      ],
      "properties": {
        "stable_count": {"type": "integer", "minimum": 0},
        "drift_count": {"type": "integer", "minimum": 0},
        "union_count": {"type": "integer", "minimum": 0},
        "stability": {"type": "number", "minimum": 0, "maximum": 1},
        "stable_items": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "drifting_items": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "dimensions"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_runs", "stability_source"],
      "properties": {
        "total_runs": {"type": "integer", "minimum": 1},
        "stability_source": {"const": "candidate_schema_patches"}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {"fields": {"$ref": "#/$defs/dimension"}}
    }
  }
}

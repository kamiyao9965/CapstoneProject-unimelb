{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quality audit batch results",
  "type": "object",
  "additionalProperties": false,
  "required": ["vertical", "schema_version", "schema_sha256", "prompt_sha256", "provider", "model", "status", "total_documents", "completed_documents", "failed_documents", "pending_documents", "documents"],
  "properties": {
    "vertical": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "minLength": 1},
    "schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prompt_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "partial"]},
    "total_documents": {"type": "integer", "minimum": 1},
    "completed_documents": {"type": "integer", "minimum": 0},
    "failed_documents": {"type": "integer", "minimum": 0},
    "pending_documents": {"type": "integer", "minimum": 0},
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_artifact", "source_artifact_sha256", "source_document", "status", "report_path", "report", "failure"],
        "properties": {
          "source_artifact": {"type": "string", "minLength": 1},
          "source_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source_document": {"type": ["string", "null"]},
          "status": {"enum": ["completed", "failed", "pending"]},
          "report_path": {"type": ["string", "null"]},
          "report": {"type": ["object", "null"]},
          "failure": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "code", "attempts", "paths"],
                "properties": {
                  "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                  "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                  "attempts": {"type": "integer", "minimum": 0},
                  "paths": {"type": "array", "maxItems": 5, "items": {"type": "string", "maxLength": 120}}
                }
              }
            ]
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone.local/contracts/artifact-envelope.schema.json",
  "title": "Pipeline artifact envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "contract_version",
    "status",
    "created_at",
    "provenance",
    "data",
    "error"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["success", "failed"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "data": {
      "type": ["object", "null"]
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/error"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "success"}}},
      "then": {
        "properties": {
          "data": {"type": "object"},
          "error": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {
        "properties": {
          "data": {"type": "null"},
          "error": {"$ref": "#/$defs/error"}
        }
      }
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "provider",
        "model",
        "document_input",
        "source_documents",
        "source_artifacts"
      ],
      "properties": {
        "run_id": {"type": ["string", "null"]},
        "vertical": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "provider": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "document_input": {"type": ["string", "null"]},
        "source_documents": {
          "type": "array",
          "items": {"type": "string"}
        },
        "source_artifacts": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {"type": "string", "minLength": 1},
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "message"],
            "properties": {
              "path": {"type": "string"},
              "message": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}

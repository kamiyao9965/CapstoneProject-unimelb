{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "jsonScalar": {"type": ["string", "number", "integer", "boolean"]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "quote_or_summary": {"type": "string"}
      }
    },
    "fieldDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field", "group", "type", "frequency", "decision", "patch_types",
        "aliases", "source_runs", "average_confidence", "description",
        "applies_to", "required", "values", "rationale_samples",
        "reject_votes", "reject_rationale_samples", "evidence_documents"
      ],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "group": {"type": "string"},
        "type": {"enum": ["string", "number", "boolean", "enum", "list[object]"]},
        "frequency": {"type": "string", "pattern": "^[0-9]+/[0-9]+$"},
        "decision": {"enum": ["core", "conditional", "candidate", "noise"]},
        "patch_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "add_field", "rename_field", "merge_fields", "move_field_group",
              "update_description", "add_alias", "reject_field"
            ]
          }
        },
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_runs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "average_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "description": {"type": "string"},
        "applies_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}
        },
        "required": {"type": ["boolean", "null"]},
        "values": {"type": "array", "items": {"$ref": "#/$defs/jsonScalar"}},
        "rationale_samples": {"type": "array", "items": {"type": "string"}},
        "reject_votes": {"type": "string", "pattern": "^[0-9]+/[0-9]+$"},
        "reject_rationale_samples": {"type": "array", "items": {"type": "string"}},
        "evidence_documents": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
        ,"has_conflict": {"type": "boolean"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["fields"],
  "properties": {
    "fields": {"type": "array", "items": {"$ref": "#/$defs/fieldDecision"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "jsonScalar": {"type": ["string", "number", "integer", "boolean"]},
    "itemField": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type", "required", "description", "values", "enum_ref"],
      "properties": {
        "name": {"type": "string"}, "type": {"enum": ["string", "number", "boolean", "enum"]},
        "required": {"type": "boolean"}, "description": {"type": ["string", "null"]},
        "values": {"type": "array", "items": {"$ref": "#/$defs/jsonScalar"}},
        "enum_ref": {"type": ["string", "null"]}
      }
    },
    "fieldUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "description", "applies_to", "required", "values", "aliases", "enum_ref", "item_fields", "unique_items"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
        "type": {"enum": ["string", "number", "boolean", "enum", "list[string]", "list[number]", "list[boolean]", "list[enum]", "list[object]"]},
        "description": {"type": "string"},
        "applies_to": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["hospital", "extras", "generalhealth", "combined"]}
        },
        "required": {"type": "boolean"},
        "values": {"type": "array", "items": {"$ref": "#/$defs/jsonScalar"}},
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "enum_ref": {"type": ["string", "null"]},
        "item_fields": {"type": "array", "items": {"$ref": "#/$defs/itemField"}},
        "unique_items": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "quote_or_summary": {"type": "string"}
      }
    },
    "queueItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "patch_types", "target_group", "canonical_name", "field_name",
        "type", "suggested_decision", "frequency", "reject_votes",
        "average_confidence", "aliases", "evidence_documents",
        "rationale_samples", "reject_rationale_samples", "needs_manual_edit",
        "needs_schema_edit", "proposed_update"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^field:[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
        "patch_types": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["add_field", "rename_field", "merge_fields", "move_field_group", "update_description", "update_field_shape", "add_alias", "reject_field"]}
        },
        "target_group": {"type": "string"},
        "canonical_name": {"type": "string", "minLength": 1},
        "field_name": {"type": "string", "minLength": 1},
        "type": {"enum": ["string", "number", "boolean", "enum", "list[string]", "list[number]", "list[boolean]", "list[enum]", "list[object]"]},
        "suggested_decision": {"enum": ["core", "conditional", "candidate", "noise"]},
        "frequency": {"type": "string", "pattern": "^[0-9]+/[0-9]+$"},
        "reject_votes": {"type": "string", "pattern": "^[0-9]+/[0-9]+$"},
        "average_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_documents": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "rationale_samples": {"type": "array", "items": {"type": "string"}},
        "reject_rationale_samples": {"type": "array", "items": {"type": "string"}},
        "needs_manual_edit": {"type": "boolean"},
        "needs_schema_edit": {"type": "boolean"},
        "proposed_update": {"$ref": "#/$defs/fieldUpdate"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "updates"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "consensus_source", "total_runs", "base_schema_path", "schema_build_samples"],
      "properties": {
        "generated_at": {"type": "string", "minLength": 1},
        "consensus_source": {"const": "candidate_schema_patches"},
        "total_runs": {"type": "integer", "minimum": 1},
        "base_schema_path": {"type": "string", "minLength": 1},
        "schema_build_samples": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "updates": {"type": "array", "items": {"$ref": "#/$defs/queueItem"}}
  }
}

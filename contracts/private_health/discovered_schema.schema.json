{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone.local/contracts/private-health/discovered-schema.schema.json",
  "title": "Discovered private health extraction schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vertical",
    "version",
    "description",
    "product_types",
    "fields",
    "hospital_categories",
    "extras_services",
    "notes"
  ],
  "properties": {
    "vertical": {"const": "private_health"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "product_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["hospital", "extras", "generalhealth", "combined"]
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/field"}
    },
    "hospital_categories": {
      "type": "array",
      "items": {"$ref": "#/$defs/canonical_item"}
    },
    "extras_services": {
      "type": "array",
      "items": {"$ref": "#/$defs/canonical_item"}
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "description",
        "applies_to",
        "required",
        "values",
        "aliases"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "type": {
          "enum": ["string", "number", "boolean", "enum", "list[object]"]
        },
        "description": {"type": "string", "minLength": 1},
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["hospital", "extras", "generalhealth", "combined"]
          }
        },
        "required": {"type": "boolean"},
        "values": {
          "type": "array",
          "items": {"type": ["string", "number", "boolean"]}
        },
        "aliases": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "canonical_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_name", "description", "aliases"],
      "properties": {
        "canonical_name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "aliases": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

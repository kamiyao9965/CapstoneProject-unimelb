{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["patches"],
  "properties": {
    "patches": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["patch_type", "target_group", "field_name", "canonical_name", "type", "description", "applies_to", "required", "values", "enum_ref", "item_fields", "unique_items", "evidence_documents", "confidence", "rationale"],
        "properties": {
          "patch_type": {"enum": ["add_field", "rename_field", "merge_fields", "move_field_group", "update_description", "update_field_shape", "add_alias", "reject_field"]},
          "target_group": {"type": "string"}, "field_name": {"type": "string"}, "canonical_name": {"type": "string"},
          "type": {"enum": ["string", "number", "boolean", "enum", "list[string]", "list[number]", "list[boolean]", "list[enum]", "list[object]"]},
          "description": {"type": "string"}, "applies_to": {"type": "array", "items": {"type": "string"}},
          "required": {"type": "boolean"}, "values": {"type": "array", "items": {"type": ["string", "number", "boolean"]}}, "enum_ref": {"type": ["string", "null"]},
          "item_fields": {"type": "array", "items": {"$ref": "#/$defs/item_field"}}, "unique_items": {"type": "boolean"},
          "evidence_documents": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "quote_or_summary"], "properties": {"path": {"type": "string"}, "quote_or_summary": {"type": "string"}}}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "rationale": {"type": "string"}
        }
      }
    }
  },
  "$defs": {"item_field": {"type": "object", "additionalProperties": false, "required": ["name", "type", "required", "description", "values", "enum_ref"], "properties": {"name": {"type": "string"}, "type": {"enum": ["string", "number", "boolean", "enum"]}, "required": {"type": "boolean"}, "description": {"type": ["string", "null"]}, "values": {"type": "array", "items": {"type": ["string", "number", "boolean"]}}, "enum_ref": {"type": ["string", "null"]}}}}
}

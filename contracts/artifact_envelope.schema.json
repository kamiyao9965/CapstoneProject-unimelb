{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone.local/contracts/artifact-envelope.schema.json",
  "title": "Pipeline artifact envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "contract_version",
    "status",
    "created_at",
    "provenance",
    "data",
    "error"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "success",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object"
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "provider",
        "model",
        "document_input",
        "source_documents",
        "source_artifacts"
      ],
      "properties": {
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "vertical": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "document_input": {
          "type": [
            "string",
            "null"
          ]
        },
        "document_parser": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pdfingestor",
            "mineru",
            null
          ]
        },
        "source_documents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "document_group_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_document_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document_id",
              "source_path",
              "document_role",
              "amends_document_ids",
              "sha256",
              "metadata"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "source_path": {
                "type": "string",
                "minLength": 1
              },
              "document_role": {
                "type": "string",
                "minLength": 1
              },
              "amends_document_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "metadata": {
                "type": "object"
              }
            }
          }
        },
        "validation_checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "applied_rules",
            "not_applicable_rules"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "applied_rules": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "not_applicable_rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rule",
                  "reason"
                ],
                "properties": {
                  "rule": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "message"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}

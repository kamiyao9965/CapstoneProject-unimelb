{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone.local/contracts/canonical-schema.schema.json",
  "title": "Human-reviewed canonical business schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "vertical",
    "version",
    "status",
    "description",
    "review",
    "output",
    "identity",
    "extension",
    "fields"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "vertical": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"enum": ["candidate", "approved"]},
    "description": {"type": "string", "minLength": 1},
    "review": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/review"}
      ]
    },
    "output": {"$ref": "#/$defs/output"},
    "identity": {"$ref": "#/$defs/identity"},
    "extension": {"$ref": "#/$defs/extension"},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/field"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "approved"}},
        "required": ["status"]
      },
      "then": {"properties": {"review": {"$ref": "#/$defs/review"}}},
      "else": {"properties": {"review": {"type": "null"}}}
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "maxLength": 63
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_by", "reviewed_at", "rationale"],
      "properties": {
        "reviewed_by": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "cardinality", "document_notes_field"],
      "properties": {
        "collection": {"$ref": "#/$defs/identifier"},
        "cardinality": {"enum": ["single", "multiple"]},
        "document_notes_field": {"const": "_document_notes"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_name_field", "product_type_field"],
      "properties": {
        "product_name_field": {"$ref": "#/$defs/identifier"},
        "product_type_field": {"$ref": "#/$defs/identifier"}
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "table", "attributes_column"],
      "properties": {
        "entity": {"$ref": "#/$defs/identifier"},
        "table": {"$ref": "#/$defs/identifier"},
        "attributes_column": {"$ref": "#/$defs/identifier"}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "description",
        "required",
        "nullable",
        "values",
        "aliases",
        "storage"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "type": {
          "enum": ["string", "number", "boolean", "enum", "list[object]"]
        },
        "description": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "nullable": {"type": "boolean"},
        "values": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "storage": {"$ref": "#/$defs/storage"}
      }
    },
    "storage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "target"],
          "properties": {
            "strategy": {"const": "core_column"},
            "target": {
              "enum": [
                "products.canonical_name",
                "product_releases.source_product_type"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "column"],
          "properties": {
            "strategy": {"const": "extension_column"},
            "column": {"$ref": "#/$defs/identifier"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {
            "strategy": {"const": "jsonb"}
          }
        }
      ]
    }
  }
}

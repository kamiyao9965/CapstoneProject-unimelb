{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone.local/contracts/travel-insurance/acquisition-run.schema.json",
  "title": "Travel insurance document acquisition run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vertical",
    "run_id",
    "source_config",
    "documents",
    "relationships",
    "product_releases",
    "review_items",
    "errors",
    "summary"
  ],
  "properties": {
    "vertical": {"const": "travel_insurance"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},
    "source_config": {"type": "string", "minLength": 1},
    "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "product_releases": {"type": "array", "items": {"$ref": "#/$defs/product_release"}},
    "review_items": {"type": "array", "items": {"$ref": "#/$defs/review_item"}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/run_error"}},
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "documentId": {"type": "string", "pattern": "^(?:sha256|urlsha256):[a-f0-9]{64}$"},
    "geographicScopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["international", "domestic", "inbound", "unknown"]}
    },
    "tripFrequencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["single_trip", "annual_multi_trip", "unknown"]}
    },
    "planTiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["comprehensive", "essentials", "basic", "medical_only", "unknown"]}
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id", "insurer_code", "brand_code", "issuer", "underwriter",
        "document_type", "title", "source_page", "discovered_url", "final_url",
        "section_heading", "anchor_text", "geographic_scopes", "trip_frequencies",
        "plan_tiers", "effective_from", "version_status", "retrieval_status",
        "validation_status", "parse_status", "local_path", "sha256", "content_type",
        "size_bytes", "error_code", "evidence"
      ],
      "properties": {
        "document_id": {"$ref": "#/$defs/documentId"},
        "insurer_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "brand_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "issuer": {"$ref": "#/$defs/nullableString"},
        "underwriter": {"$ref": "#/$defs/nullableString"},
        "document_type": {"enum": ["pds", "spds", "brochure", "tmd", "fsg", "unknown"]},
        "title": {"type": "string", "minLength": 1},
        "source_page": {"type": "string", "format": "uri", "pattern": "^https://"},
        "discovered_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "final_url": {"$ref": "#/$defs/nullableString"},
        "section_heading": {"$ref": "#/$defs/nullableString"},
        "anchor_text": {"type": "string"},
        "geographic_scopes": {"$ref": "#/$defs/geographicScopes"},
        "trip_frequencies": {"$ref": "#/$defs/tripFrequencies"},
        "plan_tiers": {"$ref": "#/$defs/planTiers"},
        "effective_from": {"type": ["string", "null"], "format": "date"},
        "version_status": {"enum": ["current", "archived", "unknown"]},
        "retrieval_status": {"enum": ["downloaded", "duplicate", "skipped", "failed"]},
        "validation_status": {"enum": ["valid_pdf", "not_pdf", "size_exceeded", "not_validated"]},
        "parse_status": {"enum": ["parsed", "no_text_layer", "encrypted", "resource_limit", "failed", "not_attempted"]},
        "local_path": {"$ref": "#/$defs/nullableString"},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "content_type": {"$ref": "#/$defs/nullableString"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "error_code": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_id", "relationship_type", "source_document_id", "target_document_id", "confidence", "evidence", "review_required", "review_reason"],
      "properties": {
        "relationship_id": {"type": "string", "minLength": 1},
        "relationship_type": {"enum": ["supplements", "summarises", "targets", "guides"]},
        "source_document_id": {"$ref": "#/$defs/documentId"},
        "target_document_id": {"$ref": "#/$defs/documentId"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "review_required": {"type": "boolean"},
        "review_reason": {"$ref": "#/$defs/nullableString"}
      }
    },
    "product_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "insurer_code", "pds_document_id", "related_document_ids", "geographic_scopes", "trip_frequencies", "plan_tiers", "effective_from", "completeness_status"],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "insurer_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "pds_document_id": {"$ref": "#/$defs/documentId"},
        "related_document_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/documentId"}},
        "geographic_scopes": {"$ref": "#/$defs/geographicScopes"},
        "trip_frequencies": {"$ref": "#/$defs/tripFrequencies"},
        "plan_tiers": {"$ref": "#/$defs/planTiers"},
        "effective_from": {"type": ["string", "null"], "format": "date"},
        "completeness_status": {"enum": ["pds_only", "associated", "review_required"]}
      }
    },
    "review_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "relationship_id", "reason", "status"],
      "properties": {
        "review_id": {"type": "string", "minLength": 1},
        "relationship_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "status": {"const": "pending"}
      }
    },
    "run_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["insurer_code", "stage", "url", "code", "message"],
      "properties": {
        "insurer_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "stage": {"enum": ["discovery", "download", "parsing"]},
        "url": {"type": ["string", "null"], "format": "uri"},
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providers_attempted", "providers_succeeded", "documents_discovered", "documents_downloaded", "valid_pdfs", "failed_documents", "relationships", "review_items"],
      "properties": {
        "providers_attempted": {"type": "integer", "minimum": 0},
        "providers_succeeded": {"type": "integer", "minimum": 0},
        "documents_discovered": {"type": "integer", "minimum": 0},
        "documents_downloaded": {"type": "integer", "minimum": 0},
        "valid_pdfs": {"type": "integer", "minimum": 0},
        "failed_documents": {"type": "integer", "minimum": 0},
        "relationships": {"type": "integer", "minimum": 0},
        "review_items": {"type": "integer", "minimum": 0}
      }
    }
  }
}

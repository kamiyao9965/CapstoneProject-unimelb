{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quality audit human review queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "queue_id",
    "vertical",
    "schema_version",
    "schema_sha256",
    "seed",
    "pass_sample_rate",
    "audited_documents",
    "judge_review_documents",
    "judge_uncertain_documents",
    "items"
  ],
  "properties": {
    "queue_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "vertical": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "seed": {
      "type": "integer"
    },
    "pass_sample_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "audited_documents": {
      "type": "integer",
      "minimum": 0
    },
    "judge_review_documents": {
      "type": "integer",
      "minimum": 0
    },
    "judge_uncertain_documents": {
      "type": "integer",
      "minimum": 0
    },
    "audited_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_artifact",
          "source_artifact_sha256",
          "source_document",
          "pdf_sha256",
          "provider",
          "model",
          "document_parser",
          "prompt_bundle_sha256"
        ],
        "properties": {
          "source_artifact": {
            "type": "string",
            "minLength": 1
          },
          "source_artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_document": {
            "type": "string",
            "minLength": 1
          },
          "pdf_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "document_parser": {
            "enum": [
              "pdfingestor",
              "mineru",
              null
            ]
          },
          "prompt_bundle_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_document_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "document_id",
                "source_path",
                "document_role",
                "amends_document_ids",
                "sha256",
                "metadata"
              ],
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_path": {
                  "type": "string",
                  "minLength": 1
                },
                "document_role": {
                  "type": "string",
                  "minLength": 1
                },
                "amends_document_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "metadata": {
                  "type": "object"
                }
              }
            }
          },
          "document_group_id": {
            "type": "string",
            "pattern": "^group_[a-f0-9]{24}$"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "kind",
          "source_document",
          "source_artifact",
          "product_index",
          "field_name",
          "issue_type",
          "reason",
          "source_page",
          "source_quote",
          "citation_verified",
          "extracted_value"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "finding",
              "uncertain",
              "pass_sample"
            ]
          },
          "source_document": {
            "type": "string",
            "minLength": 1
          },
          "source_artifact": {
            "type": "string",
            "minLength": 1
          },
          "product_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "field_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "issue_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source_page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "source_quote": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "citation_verified": {
            "type": "boolean"
          },
          "extracted_value": {},
          "source_document_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    }
  }
}

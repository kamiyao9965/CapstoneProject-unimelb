{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "jsonScalar": {"type": ["string", "number", "integer", "boolean"]},
    "itemField": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type", "required", "description", "values", "enum_ref"],
      "properties": {
        "name": {"type": "string"}, "type": {"enum": ["string", "number", "boolean", "enum"]},
        "required": {"type": "boolean"}, "description": {"type": ["string", "null"]},
        "values": {"type": "array", "items": {"$ref": "#/$defs/jsonScalar"}},
        "enum_ref": {"type": ["string", "null"]}
      }
    },
    "fieldUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "description", "applies_to", "required", "values", "aliases", "enum_ref", "item_fields", "unique_items"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
        "type": {"enum": ["string", "number", "boolean", "enum", "list[string]", "list[number]", "list[boolean]", "list[enum]", "list[object]"]},
        "description": {"type": "string", "minLength": 1},
        "applies_to": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["hospital", "extras", "generalhealth", "combined"]}
        },
        "required": {"type": "boolean"},
        "values": {"type": "array", "items": {"$ref": "#/$defs/jsonScalar"}},
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "enum_ref": {"type": ["string", "null"]},
        "item_fields": {"type": "array", "items": {"$ref": "#/$defs/itemField"}},
        "unique_items": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "reviewer_notes", "edited_update"],
      "properties": {
        "id": {"type": "string", "pattern": "^field:[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
        "action": {"enum": ["accept", "reject", "edit"]},
        "reviewer_notes": {"type": "string"},
        "edited_update": {"oneOf": [{"$ref": "#/$defs/fieldUpdate"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"const": "edit"}}, "required": ["action"]},
          "then": {"properties": {"edited_update": {"$ref": "#/$defs/fieldUpdate"}}},
          "else": {"properties": {"edited_update": {"type": "null"}}}
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "decisions"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_at", "reviewer"],
      "properties": {
        "reviewed_at": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string"}
      }
    },
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
  }
}
